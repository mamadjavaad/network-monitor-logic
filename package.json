{
  "name": "network-monitor",
  "version": "0.0.1",
  "description": "A Windows-focused security application that observes network activity, analyzes behavior, detects anomalies, and gives users understandable warnings about unusual traffic.",
  "license": "ISC",
  "author": "Mohammad Javad Fakhraei",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "build:exe": "pkg .",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "bin": "src/index.js",
  "pkg": {
    "targets": [
      "node24-win-x64"
    ],
    "outputPath": "dist",
    "assets": [
      "public/**/*",
      "node_modules/better-sqlite3/prebuilds/*.node"
    ]
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "cap": "^0.2.1",
    "cors": "^2.8.6",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "@yao-pkg/pkg": "^6.22.0",
    "node-gyp": "^13.0.2"
  }
}